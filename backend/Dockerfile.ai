# AI worker (แล็ปท็อป 32GB): EasyOCR · รันด้วย AI_LOCAL=1 แล้วให้ Cloud เรียกผ่าน HTTPS
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-tha libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-ai.txt ./
RUN pip install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements-ai.txt
COPY app ./app
RUN python -c "import easyocr; easyocr.Reader(['th','en'], gpu=False)"
ENV PORT=7860 AI_LOCAL=1 PYTHONUNBUFFERED=1
CMD ["sh","-c","uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
